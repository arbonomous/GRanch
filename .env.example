# Database connection (SQLite by default; swap provider in prisma/schema.prisma for PostgreSQL)
DATABASE_URL="file:./dev.db"

# Bearer token required in `Authorization: Bearer <AI_API_KEY>` for all /api/ai/* endpoints
AI_API_KEY="granch-instinct-dev-key-change-me"

# Optional: OpenAI API key for LLM-powered structured output parsing on /api/ai/ingest & /api/ai/query
# If omitted, GRanch falls back to its built-in deterministic natural-language parser.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
