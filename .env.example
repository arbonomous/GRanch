# PostgreSQL database connection string (Neon, Supabase, Vercel Postgres, Railway, or local Postgres)
DATABASE_URL="postgresql://user:password@host:5432/granch?sslmode=require"

# REQUIRED: Ranch Passcode to unlock the GRanch web app (fail-closed until configured)
RANCH_PASSCODE=""

# REQUIRED: Secret Bearer token required in `Authorization: Bearer <AI_API_KEY>` for Instinct AI API access
# Replace with a strong random secret in production!
AI_API_KEY="granch-instinct-dev-key-change-me"

# OPTIONAL: Dedicated HMAC secret for signing 30-day session cookies.
# If omitted, securely derived via SHA-256 from RANCH_PASSCODE + AI_API_KEY.
SESSION_SECRET=""

# Automatically seeds 15 sample cattle, 10 logs, and 8 transactions on first cloud deploy when DB is empty.
# Set to "false" if you want to start with a completely blank database.
SEED_ON_EMPTY="true"

# Optional: OpenAI API key for LLM-powered structured output parsing on /api/ai/ingest
# If omitted, GRanch falls back to its built-in deterministic natural-language parser.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
